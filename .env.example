# Environment variables for Techet
# Copy this file to .env and fill in real values for your environment.

APP_NAME=Techet
APP_ENV=development
APP_URL=http://localhost:3000

# Database
DATABASE_URL=

# Authentication
JWT_SECRET=
SESSION_SECRET=
# Used by NextAuth (Auth.js) to sign session tokens. Generate with: npx auth secret
AUTH_SECRET=

# Payment providers
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public HTTPS URL of /api/mpesa/callback (use ngrok locally)
MPESA_CALLBACK_URL=
# Random string appended to the callback URL as ?token= to reject forged callbacks
MPESA_CALLBACK_SECRET=
# sandbox, production, or mock (dev only: fakes the payment, no Safaricom needed)
MPESA_ENV=sandbox
# Production Till (Buy Goods) only: MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
# and MPESA_PARTY_B=<your till number>. MPESA_SHORTCODE is then the store number.
MPESA_TRANSACTION_TYPE=
MPESA_PARTY_B=

# Marketplace: % of each ticket sale the platform keeps; the rest is owed to the organizer
PLATFORM_FEE_PCT=10
CARD_PAYMENT_PUBLIC_KEY=
CARD_PAYMENT_SECRET_KEY=

# Notifications
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Storage
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# QR and ticketing
QR_SECRET=
TICKET_SIGNING_SECRET=

# Analytics and monitoring
ANALYTICS_KEY=
ERROR_TRACKING_DSN=
