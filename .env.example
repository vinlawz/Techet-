# Environment variables for Techet
# Copy this file to .env and fill in real values for your environment.

APP_NAME=Techet
APP_ENV=development
APP_URL=http://localhost:3000

# Database
DATABASE_URL=

# Authentication
JWT_SECRET=
SESSION_SECRET=
# Used by NextAuth (Auth.js) to sign session tokens. Generate with: npx auth secret
AUTH_SECRET=

# Payment providers
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
CARD_PAYMENT_PUBLIC_KEY=
CARD_PAYMENT_SECRET_KEY=

# Notifications
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Storage
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# QR and ticketing
QR_SECRET=
TICKET_SIGNING_SECRET=

# Analytics and monitoring
ANALYTICS_KEY=
ERROR_TRACKING_DSN=
